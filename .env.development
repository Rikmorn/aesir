# ===================
# Development Environment
# ===================
# This file is tracked in git and contains non-secret development defaults.
# Secrets should be in .env.local (gitignored).

NODE_ENV=development
LOG_LEVEL=debug

# ===================
# Database Configuration
# ===================
DATABASE_URL=postgresql://temporal:temporal@localhost:5432/temporal

# ===================
# Temporal Configuration
# ===================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ===================
# Observability
# ===================
# Enable tracing in development for debugging
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=aesir-agents

# ===================
# Placeholders (set in .env.local)
# ===================
# The following are required but should be set in .env.local:
# - ANTHROPIC_API_KEY
# - SLACK_BOT_TOKEN
# - SLACK_APP_TOKEN
# - SLACK_CHANNEL_ID
# - LINEAR_ACCESS_TOKEN
# - LINEAR_TEAM_ID
# - GITHUB_TOKEN
# - GITHUB_REPO
