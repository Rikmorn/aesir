# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment files (only .env.example is tracked)
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo

# AI tools - user-specific settings
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Database files (SQLite checkpoints)
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/

# Cloudflare Tunnel
cloudflared.yml

# Social media content (personal, not code)
socials/

# sidekick — local working state (managed by `sidekick init`)
.sidekick/cache/
.sidekick/state/

# impeccable skill working state (live sessions, critique snapshots)
.impeccable/

# superpowers scaffolding — specs/plans/logs are local working context, not project docs
docs/superpowers/
