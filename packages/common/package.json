{
  "name": "@aesir/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv-flow": "^4.1.0",
    "nanoid": "^5.1.6",
    "neverthrow": "^8.2.0",
    "pg": "^8.17.2",
    "pino": "^10.2.1",
    "pino-http": "^11.0.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
