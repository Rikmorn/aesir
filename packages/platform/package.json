{
  "name": "@aesir/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seeds/default-workspace.ts",
    "cleanup": "tsx src/scripts/run-cleanup.ts",
    "cleanup:dry-run": "tsx src/scripts/run-cleanup.ts --dry-run"
  },
  "dependencies": {
    "@aesir/common": "workspace:*",
    "@langchain/core": "^0.3.0",
    "@temporalio/client": "^1.14.1",
    "@temporalio/worker": "^1.14.1",
    "@temporalio/workflow": "^1.14.1",
    "dockerode": "^4.0.9",
    "drizzle-orm": "^0.45.1",
    "nanoid": "^5.1.6",
    "neverthrow": "^8.2.0",
    "pg": "^8.17.2",
    "pino": "^10.2.1",
    "pino-http": "^11.0.0",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.0",
    "@types/pg": "^8.16.0",
    "@types/tar-stream": "^3.1.4",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
