# Slack Integration Environment Variables

# Server Configuration
PORT=3003
NODE_ENV=development
LOG_LEVEL=info

# Connection Mode: "socket" for development, "http" for production
SLACK_MODE=socket

# Slack App Credentials
# Get these from https://api.slack.com/apps > Your App > Basic Information
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Slack OAuth Configuration
# Get these from https://api.slack.com/apps > Your App > OAuth & Permissions
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_STATE_SECRET=your-state-secret
OAUTH_CALLBACK_URL=https://your-tunnel.trycloudflare.com/oauth/callback

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=temporal
DB_PASSWORD=temporal
DB_NAME=temporal

# Encryption Key (generate with: openssl rand -hex 32)
# Required for secure token storage in production
CREDENTIAL_ENCRYPTION_KEY=

# Event Dispatch Configuration
# Where to forward Slack events for processing
# Default (Docker): http://product-agent:3005/events
# For local dev: http://localhost:3005/events
PRODUCT_AGENT_URL=http://localhost:3005/events
