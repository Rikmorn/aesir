{
  "name": "@aesir/integration-github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate": "bun scripts/migrate-credentials.ts",
    "seed:credential": "bun scripts/seed-credential.ts",
    "seed:permissions": "bun scripts/seed-permissions.ts"
  },
  "dependencies": {
    "@aesir/types": "workspace:*",
    "@aesir/platform": "workspace:*",
    "@modelcontextprotocol/sdk": "1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^5.1.0",
    "dotenv-flow": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "nanoid": "^5.1.6",
    "neverthrow": "^8.2.0",
    "pg": "^8.17.2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@aesir/test-utils": "workspace:^",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "postgres": "^3.4.7",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
