{
  "name": "@aesir/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "drizzle-kit migrate",
    "seed:directory": "bun scripts/seed-directory.ts",
    "validate:workflow": "bun scripts/validate-workflow.ts",
    "test:agents": "bun scripts/agent-tests/run.ts"
  },
  "dependencies": {
    "@aesir/platform": "workspace:*",
    "@aesir/types": "workspace:*",
    "@anthropic-ai/sdk": "^0.72.1",
    "cron-parser": "^5.10.1",
    "dotenv-flow": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "nanoid": "^5.1.16",
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0",
    "postgres": "^3.4.9",
    "voyageai": "^0.1.0",
    "yaml": "^2.9.1",
    "zod": "3.25.67",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@aesir/test-utils": "workspace:^",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
