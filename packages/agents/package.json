{
  "name": "@aesir/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "drizzle-kit migrate",
    "seed:directory": "tsx scripts/seed-directory.ts",
    "validate:workflow": "tsx scripts/validate-workflow.ts",
    "test:agents": "tsx scripts/agent-tests/run.ts"
  },
  "dependencies": {
    "@aesir/observability": "workspace:*",
    "@aesir/platform": "workspace:*",
    "@aesir/types": "workspace:*",
    "@anthropic-ai/sdk": "^0.72.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.13.0",
    "dotenv-flow": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.0",
    "fetch-retry-ts": "^1.3.1",
    "nanoid": "^5.1.6",
    "neverthrow": "^8.2.0",
    "pg": "^8.17.2",
    "pg-boss": "^12.8.0",
    "postgres": "^3.4.7",
    "voyageai": "^0.1.0",
    "yaml": "^2.8.2",
    "zod": "3.25.67",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@aesir/test-utils": "workspace:^",
    "@slack/types": "^2.19.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.8",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
