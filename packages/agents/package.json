{
  "name": "@aesir/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev-agent": "tsx src/scripts/start-dev-agent.ts",
    "product-agent": "tsx src/scripts/start-product-agent.ts"
  },
  "dependencies": {
    "@aesir/common": "workspace:*",
    "@aesir/integration-github": "workspace:*",
    "@aesir/integration-linear": "workspace:*",
    "@aesir/integrations": "workspace:*",
    "@aesir/observability": "workspace:*",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/langgraph-checkpoint-postgres": "^0.1.0",
    "@linear/sdk": "^70.0.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.13.0",
    "dotenv-flow": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.7",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@slack/types": "^2.19.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
