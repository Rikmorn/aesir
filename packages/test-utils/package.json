{
  "name": "@aesir/test-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aesir/types": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.11.0",
    "@types/node": "^22.0.0",
    "msw": "^2.12.7",
    "postgres": "^3.4.7",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
