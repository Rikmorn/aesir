{
  "name": "aesir",
  "version": "0.1.0",
  "description": "Agentic development platform for automated software workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run --exclude='**/*.integration.test.ts' --exclude='**/*.e2e.test.ts' --exclude='**/sandbox/**/*.test.ts'",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:sandbox": "vitest run -c vitest.sandbox.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "vitest run --coverage && open coverage/index.html",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "product-agent": "tsx src/scripts/start-product-agent.ts",
    "dev-agent": "tsx src/scripts/start-dev-agent.ts",
    "linear-oauth": "tsx src/scripts/linear-oauth.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev-agent": "docker compose up -d dev-agent && docker compose logs -f dev-agent",
    "docker:product-agent": "docker compose up -d product-agent && docker compose logs -f product-agent",
    "infra:up": "docker compose up -d postgresql temporal temporal-ui",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgresql temporal temporal-ui",
    "db:generate": "pnpm --filter @aesir/platform db:generate && pnpm --filter @aesir/integrations db:generate && pnpm --filter @aesir/observability db:generate",
    "db:migrate": "pnpm --filter @aesir/platform db:migrate && pnpm --filter @aesir/integrations db:migrate && pnpm --filter @aesir/observability db:migrate",
    "db:migrate:platform": "pnpm --filter @aesir/platform db:migrate",
    "db:migrate:integrations": "pnpm --filter @aesir/integrations db:migrate",
    "db:migrate:observability": "pnpm --filter @aesir/observability db:migrate",
    "prepare": "husky"
  },
  "keywords": [
    "agent",
    "ai",
    "langchain",
    "langgraph",
    "automation"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
