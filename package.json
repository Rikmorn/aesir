{
  "name": "aesir",
  "version": "0.1.0",
  "description": "Agentic development platform for automated software workflows",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "vitest",
    "test:fast": "vitest run --exclude='**/*.integration.test.ts' --exclude='**/*.e2e.test.ts' --exclude='**/sandbox/**/*.test.ts'",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:sandbox": "vitest run -c vitest.sandbox.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "vitest run --coverage && open coverage/index.html",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "infra:up": "docker compose up -d postgresql",
    "infra:logs": "docker compose logs -f postgresql",
    "db:generate": "pnpm -r db:generate",
    "db:migrate": "pnpm -r --sequential db:migrate",
    "prepare": "husky"
  },
  "keywords": [
    "agent",
    "ai",
    "automation",
    "conversation-executor"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.0"
}
