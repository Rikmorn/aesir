# ===================
# Test Environment
# ===================
# This file is tracked in git and contains test environment defaults.
# Note: .env.local is NOT loaded in test environment (by dotenv-flow design).

NODE_ENV=test
LOG_LEVEL=warn

# ===================
# Database Configuration
# ===================
# Use separate test database to avoid polluting development data
DATABASE_URL=postgresql://temporal:temporal@localhost:5432/aesir_test

# ===================
# Temporal Configuration
# ===================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ===================
# Observability
# ===================
# Disable tracing in tests to avoid noise and API calls
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=aesir-agents-test

# ===================
# Test Placeholders
# ===================
# Tests should mock external services, but if real credentials are needed
# for integration tests, set them in CI environment variables.
# - ANTHROPIC_API_KEY
# - SLACK_BOT_TOKEN
# - SLACK_APP_TOKEN
# - SLACK_CHANNEL_ID
# - LINEAR_ACCESS_TOKEN
# - LINEAR_TEAM_ID
# - GITHUB_TOKEN
# - GITHUB_REPO
