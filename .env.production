# ===================
# Production Environment
# ===================
# This file is tracked in git and contains non-secret production defaults.
# IMPORTANT: Real secrets should NEVER be in this file.
# Production secrets should be set via:
# - Environment variables in deployment platform
# - Secret management service (e.g., AWS Secrets Manager, Vault)

NODE_ENV=production
LOG_LEVEL=info

# ===================
# Database Configuration
# ===================
# Set via environment variable in deployment
# DATABASE_URL=<set in deployment environment>

# ===================
# Temporal Configuration
# ===================
# Set via environment variable in deployment
# TEMPORAL_ADDRESS=<set in deployment environment>
TEMPORAL_NAMESPACE=production

# ===================
# Observability
# ===================
# Enable tracing in production for monitoring
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=aesir-agents-production

# ===================
# Required Secrets (set in deployment)
# ===================
# All of the following MUST be set via secure environment variables:
# - ANTHROPIC_API_KEY
# - SLACK_BOT_TOKEN
# - SLACK_APP_TOKEN
# - SLACK_CHANNEL_ID
# - LINEAR_ACCESS_TOKEN
# - LINEAR_TEAM_ID
# - GITHUB_TOKEN
# - GITHUB_REPO
# - DATABASE_URL
# - TEMPORAL_ADDRESS
