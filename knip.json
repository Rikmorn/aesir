{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "exclude": ["duplicates"],
  "workspaces": {
    "packages/types": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/platform": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/test-utils": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts"]
    },
    "packages/integrations/linear": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/integrations/github": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/integrations/slack": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/observability": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/agents": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    }
  },
  "ignore": [
    "**/*.test.ts",
    "**/testing/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/db/scripts/**"
  ],
  "ignoreBinaries": ["open"]
}
