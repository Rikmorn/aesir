{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "packages/common": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/platform": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/integrations": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/observability": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/agents": {
      "entry": [
        "src/index.ts",
        "src/scripts/*.ts",
        "src/dev-agent.ts",
        "src/product-agent.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    }
  },
  "ignore": [
    "**/*.test.ts",
    "**/testing/**",
    "**/_legacy/**",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "ignoreDependencies": ["@types/*"]
}
