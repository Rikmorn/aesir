{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "exclude": ["duplicates"],
  "workspaces": {
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/platform": {
      "project": ["src/**/*.ts"]
    },
    "packages/test-utils": {
      "project": ["src/**/*.ts"]
    },
    "packages/integrations/linear": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/integrations/github": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/integrations/slack": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/observability": {
      "project": ["src/**/*.ts"]
    },
    "packages/agents": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    }
  }
}
