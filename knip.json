{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "exclude": ["duplicates"],
  "workspaces": {
    "packages/common": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/platform": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/integrations": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/observability": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    },
    "packages/agents": {
      "entry": ["src/scripts/*.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["**/*.test.ts", "**/testing/**"]
    }
  },
  "ignore": [
    "**/*.test.ts",
    "**/testing/**",
    "**/_legacy/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/db/scripts/**"
  ],
  "ignoreDependencies": ["@types/*", "pino-pretty"]
}
