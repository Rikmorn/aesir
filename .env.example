# ===================
# Anthropic Configuration
# ===================

# Anthropic API Key (required)
# Found at: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ===================
# Slack Configuration
# ===================

# Bot User OAuth Token (starts with xoxb-)
# Found at: Slack API → Your App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (starts with xapp-)
# Found at: Slack API → Your App → Basic Information → App-Level Tokens
# Must have connections:write scope for Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# ===================
# Linear Configuration
# ===================

# Linear API Key or OAuth Access Token
# API Key: Linear → Settings → API → Personal API keys → Create key
LINEAR_ACCESS_TOKEN=lin_api_your-token

# Team ID where tasks will be created
# Found in Linear team settings URL or via API
LINEAR_TEAM_ID=your-team-id

# (Optional) For OAuth token refresh
# LINEAR_CLIENT_ID=your-client-id
# LINEAR_CLIENT_SECRET=your-client-secret

# ===================
# GitHub Configuration (for Dev Agent)
# ===================

# GitHub Personal Access Token
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_your-token

# Repository in owner/repo format
GITHUB_REPO=your-org/your-repo

# Webhook secret for verifying GitHub webhooks (PR review events)
# Found in GitHub → Repository → Settings → Webhooks → Your webhook → Secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ===================
# Linear Webhooks (for Dev Agent)
# ===================

# Webhook signing secret for verifying Linear webhooks
# Found in Linear → Settings → Webhooks → Your webhook → Signing secret
LINEAR_WEBHOOK_SECRET=your-webhook-secret

# Channel ID for approval notifications
SLACK_CHANNEL_ID=C0123456789

# ===================
# Database Configuration
# ===================

# PostgreSQL connection string for LangGraph state persistence
# When running with Docker Compose, use internal network:
#   DATABASE_URL=postgresql://temporal:temporal@postgresql:5432/temporal
# When running locally against Docker PostgreSQL:
#   DATABASE_URL=postgresql://temporal:temporal@localhost:5432/temporal
DATABASE_URL=postgresql://temporal:temporal@localhost:5432/temporal

# ===================
# Temporal Configuration (for approval workflows)
# ===================

# Temporal server address
# Docker Compose internal: temporal:7233
# Local against Docker: localhost:7233
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace (default: default)
TEMPORAL_NAMESPACE=default

# ===================
# Observability (optional)
# ===================

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aesir-agents

# Environment
NODE_ENV=development

# ===================
# Cloudflare Tunnel (for webhook exposure)
# ===================

# Tunnel token from Cloudflare Zero Trust dashboard
# Required for external webhooks (Linear, GitHub) to reach local dev environment
# Found at: dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels -> Configure
# Leave empty to run without tunnel (webhooks won't work from external services)
CLOUDFLARE_TUNNEL_TOKEN=
