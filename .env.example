# ===================
# Aesir Environment Configuration
# ===================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with (required).
# Optional variables have sensible defaults or are only needed for specific features.

# ===================
# General
# ===================

NODE_ENV=development

# Log level for all services: debug, info, warn, error
LOG_LEVEL=info

# ===================
# Anthropic Configuration
# ===================

# Anthropic API Key (required)
# Found at: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ===================
# Database Configuration
# ===================

# PostgreSQL connection string
# Docker Compose internal: postgresql://temporal:temporal@postgresql:5432/temporal
# Local against Docker:    postgresql://temporal:temporal@localhost:5432/temporal
DATABASE_URL=postgresql://temporal:temporal@localhost:5432/temporal

# Individual DB connection components (used by integration services in Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=temporal
DB_PASSWORD=temporal
DB_NAME=temporal

# Credential encryption key - 32 bytes, 64 hex chars (required)
# Used to encrypt OAuth tokens and API credentials at rest in PostgreSQL
# Generate with: openssl rand -hex 32
# IMPORTANT: Back this up! Losing it means losing access to stored credentials
CREDENTIAL_ENCRYPTION_KEY=

# ===================
# Slack Configuration
# ===================

# Bot User OAuth Token - starts with xoxb- (required)
# Found at: Slack API → Your App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token - starts with xapp- (required for socket mode)
# Found at: Slack API → Your App → Basic Information → App-Level Tokens
# Must have connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token

# Channel ID for agent notifications - format: C0123456789 (required)
# Find by right-clicking channel → View channel details → scroll to bottom
SLACK_CHANNEL_ID=C0123456789

# Signing secret for verifying Slack event payloads (required)
# Found at: Slack API → Your App → Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# OAuth Application credentials (required for slack-integration OAuth flow)
# Found at: Slack API → Your App → Basic Information → App Credentials
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# Connection mode: "socket" for development, "http" for production
SLACK_MODE=socket

# OAuth callback URL for Slack (optional, falls back to localhost:3003)
# Set to your tunnel URL when running OAuth through Cloudflare
# Example: https://your-tunnel.your-domain.com/slack/oauth/callback
SLACK_OAUTH_CALLBACK_URL=

# ===================
# Linear Configuration
# ===================

# Linear API Key or OAuth Access Token (required)
# API Key: Linear → Settings → API → Personal API keys → Create key
# Or use OAuth access token from authorization flow (preferred for app identity)
LINEAR_ACCESS_TOKEN=lin_api_your-token

# Team ID where tasks will be created (required)
# Found in Linear team settings URL or via API
LINEAR_TEAM_ID=your-team-id

# OAuth Application credentials (required for linear-integration OAuth flow)
# Create at: linear.app/settings/api/applications
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret

# Webhook signing secret for verifying Linear webhooks (required)
# Found in Linear → Settings → Webhooks → Your webhook → Signing secret
LINEAR_WEBHOOK_SECRET=your-linear-webhook-secret

# OAuth callback URL for Linear (optional, falls back to localhost:3001)
# Set to your tunnel URL when running OAuth through Cloudflare
# Example: https://your-tunnel.your-domain.com/linear/oauth/callback
LINEAR_OAUTH_CALLBACK_URL=

# ===================
# GitHub Configuration
# ===================

# GitHub Personal Access Token (required)
# Create at: GitHub → Settings → Developer settings → Personal access tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_your-token

# GitHub organization/owner name (required)
GITHUB_OWNER=your-org

# Repository name (required)
GITHUB_REPO=your-repo

# Full git clone URL (required for dev-agent sandbox)
GITHUB_REPO_URL=https://github.com/your-org/your-repo.git

# Base branch for PRs (defaults to "main" if not set)
GITHUB_BASE_BRANCH=main

# Webhook secret for verifying GitHub webhooks (required)
# Set this when creating webhook in GitHub → Repository → Settings → Webhooks
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# OAuth Application credentials (required for github-integration OAuth flow)
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth callback URL for GitHub (optional, falls back to localhost:3002)
# Set to your tunnel URL when running OAuth through Cloudflare
# Example: https://your-tunnel.your-domain.com/github/oauth/github/callback
GITHUB_OAUTH_CALLBACK_URL=

# ===================
# Agent Configuration
# ===================

# Dev Agent: Slack channel for notifications (required for dev-agent)
DEV_AGENT_SLACK_CHANNEL=C0123456789

# Product Agent: Comma-separated channel IDs the bot is allowed to respond in
# Leave empty to allow all channels
PRODUCT_AGENT_ALLOWED_CHANNELS=

# ===================
# Agent Service Configuration
# ===================

# Port for the unified agent service (default: 3004)
AGENT_SERVICE_PORT=3004

# Maximum number of conversations running simultaneously (default: 5)
MAX_CONCURRENT_CONVERSATIONS=5

# How often the worker polls for queued conversations in ms (default: 5000)
WORKER_POLL_INTERVAL_MS=5000

# Grace period before forced shutdown in ms (default: 30000)
FORCE_SHUTDOWN_TIMEOUT_MS=30000

# Slack channel for routing failure alerts (optional)
ROUTER_ALERTS_CHANNEL=

# ===================
# Observability (optional)
# ===================

# LangSmith tracing - set to true and provide API key to enable
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aesir-agents

# ===================
# Cloudflare Tunnel (optional)
# ===================

# Tunnel token from Cloudflare Zero Trust dashboard
# Required for external webhooks (Linear, GitHub) to reach local dev environment
# Found at: dash.cloudflare.com → Zero Trust → Networks → Tunnels → Configure
# Leave empty to run without tunnel (webhooks won't work from external services)
CLOUDFLARE_TUNNEL_TOKEN=
